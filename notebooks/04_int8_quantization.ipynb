    "## 7 基准测试\n",
    "\n",
    "量化最直接的收益体现在**显存占用**和**推理延迟**上。本节对以下方案进行基准测试：\n",
    "\n",
    "| 方案 | 说明 |\n",
    "|------|------|\n",
    "| `fp32_standard` | FP32 标准注意力（math backend） |\n",
    "| `fp16_flash` | FP16 + `F.sdpa`（GPU 上触发 Flash Attention kernel） |\n",
    "| `int8_weight_dyn` | INT8 权重动态量化（`torch.quantization.quantize_dynamic`，CPU） |\n",
    "| `int8_fake_qkv` | 模拟量化 Q/K/V 激活值为 INT8，权重 FP32（演示激活量化的代价） |\n",
    "\n",
    "结果保存至 `results/04_benchmark_quantization.json`，供 Notebook 05 综合比较使用。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa04_sec7_helpers",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 基准测试辅助函数 ───────────────────────────────────────────────────────────\n",
    "\n",
    "def measure_latency_memory(fn, *args, n_warmup=5, n_repeat=20, label=\"\") -> dict:\n",
    "    \"\"\"测量延迟（ms）和 GPU 峰值显存（MB）。与 Notebook 03 接口一致。\"\"\"\n",
    "    dev = args[0].device if hasattr(args[0], 'device') else torch.device('cpu')\n",
    "\n",
    "    for _ in range(n_warmup):\n",
    "        with torch.no_grad():\n",
    "            fn(*args)\n",
    "\n",
    "    if dev.type == \"cuda\":\n",
    "        torch.cuda.synchronize()\n",
    "        torch.cuda.reset_peak_memory_stats(dev)\n",
    "        with torch.no_grad():\n",
    "            fn(*args)\n",
    "        torch.cuda.synchronize()\n",
    "        mem_mb = torch.cuda.max_memory_allocated(dev) / 1e6\n",
    "    else:\n",
    "        mem_mb = float(\"nan\")\n",
    "\n",
    "    t = benchmark.Timer(\n",
    "        stmt=\"fn(*args)\",\n",
    "        globals={\"fn\": fn, \"args\": args},\n",
    "        label=label,\n",
    "        num_threads=1,\n",
    "    )\n",
    "    result = t.timeit(n_repeat)\n",
    "    return {\n",
    "        \"impl\": label,\n",
    "        \"seq_len\": args[0].shape[-2] if hasattr(args[0], 'shape') else 0,\n",
    "        \"latency_ms\": result.mean * 1e3,\n",
    "        \"memory_mb\": mem_mb,\n",
    "        \"dtype\": str(args[0].dtype) if hasattr(args[0], 'dtype') else \"unknown\",\n",
    "        \"device\": str(dev),\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa04_sec7_bench",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 基准测试配置与运行 ────────────────────────────────────────────────────────\n",
    "BATCH_B, HEADS_B, D_HEAD_B = 1, 8, 64\n",
    "SEQ_LENS_B = [256, 512, 1024, 2048] if device == \"cuda\" else [64, 128, 256, 512]\n",
    "\n",
    "# --- 实现定义 -----------------------------------------------------------------\n",
    "\n",
    "def run_fp32_standard(Q, K, V):\n",
    "    \"\"\"FP32 math backend（标准注意力基线）。\"\"\"\n",
    "    if Q.device.type == \"cuda\":\n",
    "        with torch.backends.cuda.sdp_kernel(\n",
    "            enable_flash=False, enable_math=True, enable_mem_efficient=False\n",
    "        ):\n",
    "            return F.scaled_dot_product_attention(Q, K, V)\n",
    "    return F.scaled_dot_product_attention(Q, K, V)\n",
    "\n",
    "\n",
    "def run_fp16_flash(Q, K, V):\n",
    "    \"\"\"FP16 + F.sdpa（GPU 上自动触发 Flash Attention）。\"\"\"\n",
    "    return F.scaled_dot_product_attention(Q, K, V)\n",
    "\n",
    "\n",
    "def run_int8_fake_qkv(Q, K, V):\n",
    "    \"\"\"模拟量化 Q/K/V 为 INT8，衡量激活量化对延迟的影响（包含 fake-quant 开销）。\"\"\"\n",
    "    Q_q, _, _ = fake_quantize(Q, bits=8, symmetric=True)\n",
    "    K_q, _, _ = fake_quantize(K, bits=8, symmetric=True)\n",
    "    V_q, _, _ = fake_quantize(V, bits=8, symmetric=True)\n",
    "    return F.scaled_dot_product_attention(Q_q, K_q, V_q)\n",
    "\n",
    "\n",
    "# 动态量化模型（CPU）\n",
    "model_for_bench = SimpleAttentionProjection(HEADS_B * D_HEAD_B, HEADS_B).eval()\n",
    "model_int8_bench = torch.quantization.quantize_dynamic(\n",
    "    model_for_bench, {nn.Linear}, dtype=torch.qint8\n",
    ")\n",
    "\n",
    "def run_int8_weight_dyn(x_flat):\n",
    "    \"\"\"INT8 权重动态量化：输入为 (B, N, d_model)。\"\"\"\n",
    "    return model_int8_bench(x_flat)\n",
    "\n",
    "\n",
    "# --- 运行基准 -----------------------------------------------------------------\n",
    "all_bench_records = []\n",
    "\n",
    "print(f\"设备: {device}  |  batch={BATCH_B}, heads={HEADS_B}, d_head={D_HEAD_B}\")\n",
    "print(f\"{'N':>6}  {'方案':>22}  {'延迟(ms)':>10}  {'显存(MB)':>10}\")\n",
    "print(\"-\" * 56)\n",
    "\n",
    "for N in SEQ_LENS_B:\n",
    "    torch.manual_seed(0)\n",
    "    dtype_fp32 = torch.float32\n",
    "    dtype_fp16 = torch.float16 if device == \"cuda\" else torch.float32\n",
    "\n",
    "    Q32 = torch.randn(BATCH_B, HEADS_B, N, D_HEAD_B, device=device, dtype=dtype_fp32)\n",
    "    K32 = torch.randn(BATCH_B, HEADS_B, N, D_HEAD_B, device=device, dtype=dtype_fp32)\n",
    "    V32 = torch.randn(BATCH_B, HEADS_B, N, D_HEAD_B, device=device, dtype=dtype_fp32)\n",
    "\n",
    "    Q16 = Q32.to(dtype_fp16)\n",
    "    K16 = K32.to(dtype_fp16)\n",
    "    V16 = V32.to(dtype_fp16)\n",
    "\n",
    "    x_flat_cpu = torch.randn(BATCH_B, N, HEADS_B * D_HEAD_B)  # CPU 动态量化用\n",
    "\n",
    "    bench_cases = [\n",
    "        (\"fp32_standard\",    run_fp32_standard,    (Q32, K32, V32)),\n",
    "        (\"fp16_flash\",       run_fp16_flash,       (Q16, K16, V16)),\n",
    "        (\"int8_fake_qkv\",    run_int8_fake_qkv,    (Q32, K32, V32)),\n",
    "        (\"int8_weight_dyn\",  run_int8_weight_dyn,  (x_flat_cpu,)),\n",
    "    ]\n",
    "\n",
    "    for name, fn, args in bench_cases:\n",
    "        try:\n",
    "            rec = measure_latency_memory(fn, *args, label=name)\n",
    "            rec[\"seq_len\"] = N\n",
    "            all_bench_records.append(rec)\n",
    "            print(f\"{N:>6}  {name:>22}  {rec['latency_ms']:>10.3f}  \"\n",
    "                  f\"{rec['memory_mb']:>10.1f}\")\n",
    "        except Exception as e:\n",
    "            print(f\"{N:>6}  {name:>22}  SKIP: {e}\")\n",
    "\n",
    "with open(\"../results/04_benchmark_quantization.json\", \"w\") as f:\n",
    "    json.dump(all_bench_records, f, indent=2)\n",
    "print(f\"\\n基准数据已保存至 results/04_benchmark_quantization.json\")"
   ]
  },
