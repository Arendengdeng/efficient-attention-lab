    "# ── 可视化注意力各张量的数值分布 ─────────────────────────────────────────────\n",
    "torch.manual_seed(42)\n",
    "B_d, H_d, N_d, d_d = 2, 8, 256, 64\n",
    "\n",
    "Q_d = torch.randn(B_d, H_d, N_d, d_d)\n",
    "K_d = torch.randn(B_d, H_d, N_d, d_d)\n",
    "V_d = torch.randn(B_d, H_d, N_d, d_d)\n",
    "\n",
    "with torch.no_grad():\n",
    "    S_d = torch.matmul(Q_d, K_d.transpose(-2, -1)) / math.sqrt(d_d)\n",
    "    A_d = torch.softmax(S_d, dim=-1)\n",
    "    O_d = torch.matmul(A_d, V_d)\n",
    "\n",
    "tensors = {\n",
    "    \"Q (query)\": Q_d,\n",
    "    \"K (key)\": K_d,\n",
    "    \"V (value)\": V_d,\n",
    "    \"S = QKᵀ/√d\": S_d,\n",
    "    \"A = softmax(S)\": A_d,\n",
    "    \"O = AV\": O_d,\n",
    "}\n",
