    "mse_matrix = np.zeros_like(cos_matrix)\n",
    "\n",
    "for bi, bits in enumerate(bits_vis):\n",
    "    for ni, N in enumerate(seq_lens_e):\n",
    "        Q_v2 = torch.randn(B_v2, H_v2, N, d_v2)\n",
    "        K_v2 = torch.randn(B_v2, H_v2, N, d_v2)\n",
    "        V_v2 = torch.randn(B_v2, H_v2, N, d_v2)\n",
    "        with torch.no_grad():\n",
    "            ref = F.scaled_dot_product_attention(Q_v2, K_v2, V_v2)\n",
    "            out = attention_with_quantized_qkv(Q_v2, K_v2, V_v2, bits=bits)\n",
    "        cos_matrix[bi, ni] = F.cosine_similarity(\n",
    "            ref.flatten(), out.flatten(), dim=0).item()\n",
    "        mse_matrix[bi, ni] = F.mse_loss(out, ref).item()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "colors_b = plt.cm.plasma(np.linspace(0.1, 0.9, len(bits_vis)))\n",
    "\n",
    "for bi, (bits, c) in enumerate(zip(bits_vis, colors_b)):\n",
    "    axes[0].plot(seq_lens_e, cos_matrix[bi], marker=\"o\", color=c,\n",
    "                 linewidth=1.8, label=f\"INT{bits}\")\n",
    "    axes[1].semilogy(seq_lens_e, mse_matrix[bi], marker=\"o\", color=c,\n",
    "                     linewidth=1.8, label=f\"INT{bits}\")\n",
    "\n",
    "axes[0].set_xlabel(\"序列长度 N\"); axes[0].set_ylabel(\"余弦相似度\")\n",
    "axes[0].set_title(\"量化输出与 FP32 的余弦相似度\")\n",
    "axes[0].set_ylim(0.9, 1.002); axes[0].legend(); axes[0].grid(alpha=0.3)\n",
    "\n",
    "axes[1].set_xlabel(\"序列长度 N\"); axes[1].set_ylabel(\"MSE（对数坐标）\")\n",
    "axes[1].set_title(\"量化输出 MSE vs 序列长度\")\n",
    "axes[1].legend(); axes[1].grid(alpha=0.3, which=\"both\")\n",
    "\n",
    "plt.suptitle(\"量化误差分析（Q+K+V 全量化，对称 INT-n）\",\n",
    "             fontsize=13, fontweight=\"bold\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"../results/04_quant_error_analysis.png\", dpi=120, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "print(\"图像已保存至 results/04_quant_error_analysis.png\")\n",
