    "## 5 量化误差分析\n",
    "\n",
    "量化对注意力输出的影响可以从三个维度衡量：\n",
    "\n",
    "1. **余弦相似度（Cosine Similarity）**：衡量方向误差，接近 1.0 表示输出方向几乎不变\n",
    "2. **均方误差（MSE）**：衡量绝对数值误差大小\n",
    "3. **相对误差（Relative Error）**：$\\|\\hat{x} - x\\|_2 / \\|x\\|_2$，归一化后更易对比\n",
    "\n",
    "此节将系统评估：\n",
    "- 不同位宽（INT4 / INT8 / INT16）的误差对比\n",
    "- 量化哪个张量（$Q$/$K$/$V$/ 权重）误差最大\n",
    "- 序列长度对误差的影响"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa04_sec5_bitwidth",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── 不同位宽的注意力输出误差 ──────────────────────────────────────────────────\n",
    "\n",
    "def attention_with_quantized_qkv(\n",
    "    Q: torch.Tensor, K: torch.Tensor, V: torch.Tensor,\n",
    "    bits: int = 8, symmetric: bool = True\n",
    ") -> torch.Tensor:\n",
    "    \"\"\"对 Q、K、V 分别施加模拟量化后计算注意力。\"\"\"\n",
    "    Q_q, _, _ = fake_quantize(Q, bits=bits, symmetric=symmetric)\n",
    "    K_q, _, _ = fake_quantize(K, bits=bits, symmetric=symmetric)\n",
    "    V_q, _, _ = fake_quantize(V, bits=bits, symmetric=symmetric)\n",
    "    return F.scaled_dot_product_attention(Q_q, K_q, V_q)\n",
    "\n",
    "\n",
    "torch.manual_seed(0)\n",
    "B_e, H_e, N_e, d_e = 2, 8, 256, 64\n",
    "Q_e = torch.randn(B_e, H_e, N_e, d_e)\n",
    "K_e = torch.randn(B_e, H_e, N_e, d_e)\n",
    "V_e = torch.randn(B_e, H_e, N_e, d_e)\n",
    "\n",
    "with torch.no_grad():\n",
    "    ref_out = F.scaled_dot_product_attention(Q_e, K_e, V_e)\n",
    "\n",
    "print(\"=== 不同位宽：注意力输出误差 ===\")\n",
    "print(f\"{'位宽':>6}  {'余弦相似度':>12}  {'MSE':>12}  {'相对误差(%)':>12}\")\n",
    "print(\"-\" * 50)\n",
    "\n",
    "bits_list = [4, 6, 8, 12, 16]\n",
    "results_bits = []\n",
    "for bits in bits_list:\n",
    "    with torch.no_grad():\n",
    "        out_q = attention_with_quantized_qkv(Q_e, K_e, V_e, bits=bits)\n",
    "    cos = F.cosine_similarity(ref_out.flatten(), out_q.flatten(), dim=0).item()\n",
    "    mse = F.mse_loss(out_q, ref_out).item()\n",
    "    rel = (out_q - ref_out).norm() / ref_out.norm() * 100\n",
    "    results_bits.append({\"bits\": bits, \"cos\": cos, \"mse\": mse, \"rel\": rel.item()})\n",
    "    print(f\"INT{bits:>2}  {cos:>12.6f}  {mse:>12.2e}  {rel:>12.4f}\")"
   ]
  },
