    "# ── torch.ao.quantization 静态量化（PTQ）────────────────────────────────────\n",
    "# 注：静态量化需要可融合的 CPU kernel，此处演示配置流程\n",
    "\n",
    "import copy\n",
    "from torch.ao.quantization import (\n",
    "    get_default_qconfig,\n",
    "    prepare,\n",
    "    convert,\n",
    ")\n",
    "\n",
    "class LinearBlock(nn.Module):\n",
    "    \"\"\"最小可量化单元：Linear + ReLU（可融合）。\"\"\"\n",
    "    def __init__(self, in_f: int, out_f: int):\n",
    "        super().__init__()\n",
    "        self.linear = nn.Linear(in_f, out_f)\n",
    "        self.relu = nn.ReLU()\n",
    "    def forward(self, x):\n",
    "        return self.relu(self.linear(x))\n",
    "\n",
    "\n",
    "lb_fp32 = LinearBlock(256, 256).eval()\n",
    "lb_static = copy.deepcopy(lb_fp32)\n",
    "\n",
    "# 步骤 1：设置 qconfig\n",
    "lb_static.qconfig = get_default_qconfig(\"x86\")\n",
    "\n",
    "# 步骤 2：插入 observer\n",
    "prepare(lb_static, inplace=True)\n",
    "\n",
    "# 步骤 3：校准（用随机数模拟校准数据）\n",
    "torch.manual_seed(1)\n",
    "for _ in range(32):\n",
    "    with torch.no_grad():\n",
    "        lb_static(torch.randn(8, 256))\n",
    "\n",
    "# 步骤 4：转换为量化模型\n",
    "convert(lb_static, inplace=True)\n",
    "\n",
    "# 验证\n",
    "x_lb = torch.randn(4, 256)\n",
    "with torch.no_grad():\n",
    "    out_lb_fp = lb_fp32(x_lb)\n",
    "    out_lb_q  = lb_static(x_lb)\n",
    "\n",
    "cos_lb = F.cosine_similarity(out_lb_fp.flatten(), out_lb_q.flatten(), dim=0).item()\n",
    "mse_lb = F.mse_loss(out_lb_q, out_lb_fp).item()\n",
    "print(\"=== 静态量化（torch.ao.quantization PTQ）===\")\n",
    "print(f\"输出余弦相似度: {cos_lb:.6f}\")\n",
    "print(f\"输出 MSE      : {mse_lb:.6e}\")\n",
    "print(f\"量化后模型结构:\\n{lb_static}\")"
