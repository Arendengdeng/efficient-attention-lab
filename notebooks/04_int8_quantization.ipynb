   "source": [
    "# ── 量化哪个张量影响最大？ ────────────────────────────────────────────────────\n",
    "BITS = 8\n",
    "\n",
    "def attn_quant_Q(Q, K, V, bits=BITS):\n",
    "    Qq, _, _ = fake_quantize(Q, bits=bits); return F.scaled_dot_product_attention(Qq, K, V)\n",
    "\n",
    "def attn_quant_K(Q, K, V, bits=BITS):\n",
    "    Kq, _, _ = fake_quantize(K, bits=bits); return F.scaled_dot_product_attention(Q, Kq, V)\n",
    "\n",
    "def attn_quant_V(Q, K, V, bits=BITS):\n",
    "    Vq, _, _ = fake_quantize(V, bits=bits); return F.scaled_dot_product_attention(Q, K, Vq)\n",
    "\n",
    "def attn_quant_all(Q, K, V, bits=BITS):\n",
    "    return attention_with_quantized_qkv(Q, K, V, bits=bits)\n",
    "\n",
    "cases = [\n",
    "    (\"仅量化 Q\",    attn_quant_Q),\n",
    "    (\"仅量化 K\",    attn_quant_K),\n",
    "    (\"仅量化 V\",    attn_quant_V),\n",
    "    (\"Q+K+V 全量化\", attn_quant_all),\n",
    "]\n",
    "\n",
    "print(f\"=== INT{BITS}：各张量量化对输出的影响 ===\")\n",
    "print(f\"{'方案':>14}  {'余弦相似度':>12}  {'MSE':>12}  {'相对误差(%)':>12}\")\n",
    "print(\"-\" * 56)\n",
    "for name, fn in cases:\n",
    "    with torch.no_grad():\n",
    "        out = fn(Q_e, K_e, V_e)\n",
    "    cos = F.cosine_similarity(ref_out.flatten(), out.flatten(), dim=0).item()\n",
    "    mse = F.mse_loss(out, ref_out).item()\n",
    "    rel = (out - ref_out).norm() / ref_out.norm() * 100\n",
    "    print(f\"{name:>14}  {cos:>12.6f}  {mse:>12.2e}  {rel:>12.4f}\")"
   ]
