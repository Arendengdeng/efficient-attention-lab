    "# ── 误差随序列长度的变化 & 位宽-误差曲线可视化 ───────────────────────────────\n",
    "torch.manual_seed(42)\n",
    "seq_lens_e = [64, 128, 256, 512, 1024]\n",
    "bits_vis   = [4, 6, 8, 12, 16]\n",
