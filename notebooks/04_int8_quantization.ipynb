   "source": [
    "## 4 `torch.quantization` / `bitsandbytes` 工具链\n",
    "\n",
    "### 4.1 `torch.quantization` 动态量化\n",
    "\n",
    "`torch.quantization.quantize_dynamic` 是最简单的 PTQ 入口，适用于 `nn.Linear` 层：在权重量化为 INT8（逐通道），激活值在每次推理时动态量化。无需校准数据集，一行代码完成转换。\n",
    "\n",
    "```python\n",
    "model_int8 = torch.quantization.quantize_dynamic(\n",
    "    model,\n",
    "    {torch.nn.Linear},   # 量化这些层类型\n",
    "    dtype=torch.qint8\n",
    ")\n",
    "```\n",
    "\n",
    "### 4.2 `torch.ao.quantization` 静态量化\n",
    "\n",
    "静态量化（Static PTQ）需要校准步骤，适合对精度要求更高的场景：\n",
    "\n",
    "```\n",
    "1. model.qconfig = get_default_qconfig('x86')  # 设置量化配置\n",
    "2. prepare(model, inplace=True)                # 插入 observer 钩子\n",
    "3. 运行校准数据（forward pass）                 # observer 收集统计量\n",
    "4. convert(model, inplace=True)               # 将 observer 替换为量化参数\n",
    "```\n",
    "\n",
    "### 4.3 `bitsandbytes` INT8 线性层\n",
    "\n",
    "`bitsandbytes` 提供 `nn.Linear` 的直接替代：`bnb.nn.Linear8bitLt`，使用 LLM.int8() 算法（混合精度分解），在 CUDA 上实现真实的 INT8 矩阵乘。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa04_sec4_dynamic",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── torch.quantization 动态量化：应用于 MHA 投影层 ────────────────────────────\n",
    "\n",
    "class SimpleAttentionProjection(nn.Module):\n",
    "    \"\"\"简化版 MHA 投影层，用于演示量化工具链。\"\"\"\n",
    "    def __init__(self, d_model: int = 512, n_heads: int = 8):\n",
    "        super().__init__()\n",
    "        self.d_model = d_model\n",
    "        self.n_heads = n_heads\n",
    "        self.d_head = d_model // n_heads\n",
    "        self.q_proj = nn.Linear(d_model, d_model, bias=False)\n",
    "        self.k_proj = nn.Linear(d_model, d_model, bias=False)\n",
    "        self.v_proj = nn.Linear(d_model, d_model, bias=False)\n",
    "        self.out_proj = nn.Linear(d_model, d_model, bias=False)\n",
    "\n",
    "    def forward(self, x: torch.Tensor) -> torch.Tensor:\n",
    "        B, N, _ = x.shape\n",
    "        scale = 1.0 / math.sqrt(self.d_head)\n",
    "        Q = self.q_proj(x).view(B, N, self.n_heads, self.d_head).transpose(1, 2)\n",
    "        K = self.k_proj(x).view(B, N, self.n_heads, self.d_head).transpose(1, 2)\n",
    "        V = self.v_proj(x).view(B, N, self.n_heads, self.d_head).transpose(1, 2)\n",
    "        attn = F.scaled_dot_product_attention(Q, K, V)\n",
    "        out = attn.transpose(1, 2).contiguous().view(B, N, self.d_model)\n",
    "        return self.out_proj(out)\n",
    "\n",
    "\n",
    "torch.manual_seed(0)\n",
    "D_MODEL, N_HEADS = 512, 8\n",
    "model_fp32 = SimpleAttentionProjection(D_MODEL, N_HEADS).eval()\n",
    "\n",
    "# 动态量化（CPU 上生效，GPU 需要额外配置）\n",
    "model_int8_dyn = torch.quantization.quantize_dynamic(\n",
    "    model_fp32,\n",
    "    {nn.Linear},\n",
    "    dtype=torch.qint8,\n",
    ")\n",
    "\n",
    "# 验证输出\n",
    "x_demo2 = torch.randn(2, 64, D_MODEL)\n",
    "with torch.no_grad():\n",
    "    out_fp32 = model_fp32(x_demo2)\n",
    "    out_int8 = model_int8_dyn(x_demo2)\n",
    "\n",
    "cos_sim = F.cosine_similarity(out_fp32.flatten(), out_int8.flatten(), dim=0).item()\n",
    "mse     = F.mse_loss(out_int8, out_fp32).item()\n",
    "print(\"=== 动态量化（torch.quantization.quantize_dynamic）===\")\n",
    "print(f\"输出余弦相似度: {cos_sim:.6f}\")\n",
    "print(f\"输出 MSE      : {mse:.6e}\")\n",
    "\n",
    "# 显存占用对比（参数量）\n",
    "def model_size_mb(m):\n",
    "    total = sum(p.nelement() * p.element_size() for p in m.parameters())\n",
    "    total += sum(b.nelement() * b.element_size() for b in m.buffers())\n",
    "    return total / 1e6\n",
    "\n",
    "sz_fp32 = model_size_mb(model_fp32)\n",
    "sz_int8 = model_size_mb(model_int8_dyn)\n",
    "print(f\"\\n模型参数大小 FP32: {sz_fp32:.2f} MB\")\n",
    "print(f\"模型参数大小 INT8: {sz_int8:.2f} MB\")\n",
    "print(f\"压缩比: {sz_fp32/sz_int8:.2f}×\")"
   ]
  },
